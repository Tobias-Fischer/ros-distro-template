# This file is generated from ros-distro-template (template/vinca_pinning.yaml.jinja).
# If you change it here, upstream the change: comment `@robostack-bot upstream-to-template` on your PR.

# The shared values come from pinning/conda_forge.yaml and pinning/overrides.yaml
# in the template repository.
[% if conda_forge_pinning_version %]
# This distribution stays on an older conda-forge pinning (copier answers
# conda_forge_pinning_version / conda_forge_migrations).
conda_forge_pinning_version: [= conda_forge_pinning_version =]
migrations:
[% for migration in conda_forge_migrations %]
  - [= migration =]
[% endfor %]
[% else %]
[% include "pinning/conda_forge.yaml" %]
[% endif %]
[# Shared overrides; keys this distribution overrides itself (pinning_overrides
   answer) are left out, together with the comment lines above them. #]
[% set shared_text %][% include "pinning/overrides.yaml" %][% endset %]
[% set ns = namespace(comments=[], skip=false) %]
[% for line in shared_text.splitlines() %]
[% set key = line[2:].split(":")[0] if line.startswith("  ") and not line.startswith("   ") and not line.strip().startswith("#") else none %]
[% if line.strip().startswith("#") and line.startswith("  ") %]
[% set ns.comments = ns.comments + [line] %]
[% elif key %]
[% set ns.skip = key in pinning_overrides %]
[% if not ns.skip %]
[% for comment in ns.comments %]
[= comment =]
[% endfor %]
[= line =]
[% endif %]
[% set ns.comments = [] %]
[% elif line.startswith("    ") %]
[% if not ns.skip %]
[= line =]
[% endif %]
[% else %]
[= line =]
[% endif %]
[% endfor %]
[% if pinning_overrides %]
  # ros-[= distro =] specific (copier answer pinning_overrides)
[% for key, value in pinning_overrides.items() %]
  [= key =]:
[% for item in (value if value is sequence and value is not string else [value]) %]
    - [= item =]
[% endfor %]
[% endfor %]
[% endif %]
