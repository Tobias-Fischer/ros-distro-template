# robostack-bot: routine maintenance for ros-[= distro =].
#
# - weekly: refresh the rosdistro snapshot and the conda-forge pinning (one PR each)
# - on demand: Actions > robostack-bot > Run workflow, or comment on an issue/PR:
#     @robostack-bot rerender | update-snapshot | update-pinning | check-stale | drift | upstream
#   (owners, members and collaborators only)
# - on pull requests: warn when template-owned files are edited by hand
#
# The bot logic lives in [= template_url =] (robostack_bot/).
# PRs are opened with the robostack-bot GitHub App token (vars.ROBOSTACK_BOT_APP_ID +
# secrets.ROBOSTACK_BOT_PRIVATE_KEY), falling back to secrets.GHA_PAT, so that
# testpr.yml runs on them (PRs opened with GITHUB_TOKEN don't trigger workflows).
name: robostack-bot

on:
  schedule:
    - cron: "17 3 * * 1"
  workflow_dispatch:
    inputs:
      command:
        description: Command to run
        type: choice
        options: [rerender, update-snapshot, update-pinning, check-stale, drift]
      vcs_ref:
        description: Template version for rerender (default latest)
        required: false
  issue_comment:
    types: [created]
  pull_request:

permissions:
  contents: read

env:
  TEMPLATE_URL: [= template_url =]
  BOT: uvx --from git+[= template_url =] robostack-bot

jobs:
  drift:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@v7
      - name: Check template-owned files
        id: bot
        run: $BOT --summary "$RUNNER_TEMP/summary.md" drift
      - name: Report
        if: steps.bot.outputs.ok == 'false'
        env:
          GH_TOKEN: ${{ github.token }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          cat "$RUNNER_TEMP/summary.md" >> "$GITHUB_STEP_SUMMARY"
          echo "::warning::Template-owned files were edited; see the job summary."
          gh pr edit "$PR" --repo "$GITHUB_REPOSITORY" --add-label upstream-to-template || true

  plan:
    if: >-
      github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' ||
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@robostack-bot'))
    runs-on: ubuntu-latest
    outputs:
      commands: ${{ steps.plan.outputs.commands }}
    steps:
      - uses: astral-sh/setup-uv@v7
      - name: Decide what to run
        id: plan
        env:
          EVENT: ${{ github.event_name }}
          INPUT: ${{ inputs.command }}
          BODY: ${{ github.event.comment.body }}
          ASSOCIATION: ${{ github.event.comment.author_association }}
        run: |
          case "$EVENT" in
            schedule) commands='["update-snapshot","update-pinning"]' ;;
            workflow_dispatch) commands="[\"$INPUT\"]" ;;
            issue_comment)
              command=$($BOT parse-comment --body "$BODY" --association "$ASSOCIATION")
              if [ -n "$command" ]; then commands="[\"$command\"]"; else commands='[]'; fi ;;
          esac
          echo "commands=$commands" >> "$GITHUB_OUTPUT"

  run:
    needs: plan
    if: needs.plan.outputs.commands != '[]'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        command: ${{ fromJSON(needs.plan.outputs.commands) }}
    permissions:
      contents: write
      pull-requests: write
      issues: write
    steps:
      - name: Bot token
        id: app
        if: vars.ROBOSTACK_BOT_APP_ID != ''
        uses: actions/create-github-app-token@v2
        with:
          app-id: ${{ vars.ROBOSTACK_BOT_APP_ID }}
          private-key: ${{ secrets.ROBOSTACK_BOT_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: ${{ github.event.repository.name }},ros-distro-template

      - uses: actions/checkout@v6
        with:
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT || github.token }}
          fetch-depth: 0

      - uses: prefix-dev/setup-pixi@v0.10.2
        with:
          pixi-version: v0.75.0
          run-install: false
      - uses: astral-sh/setup-uv@v7

      - name: Check out the template (upstream)
        if: matrix.command == 'upstream'
        uses: actions/checkout@v6
        with:
          repository: RoboStack/ros-distro-template
          path: .template-src
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT }}

      - name: robostack-bot ${{ matrix.command }}
        id: bot
        env:
          COMMAND: ${{ matrix.command }}
          VCS_REF: ${{ inputs.vcs_ref }}
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          git config --global user.name "robostack-bot"
          git config --global user.email "robostack-bot@users.noreply.github.com"
          args=()
          case "$COMMAND" in
            rerender) [ -n "$VCS_REF" ] && args+=(--vcs-ref "$VCS_REF") ;;
            upstream) args+=(--template-dir .template-src) ;;
          esac
          $BOT --summary "$RUNNER_TEMP/summary.md" "$COMMAND" "${args[@]}"
          cat "$RUNNER_TEMP/summary.md" >> "$GITHUB_STEP_SUMMARY"

      - name: Open or update the pull request
        if: steps.bot.outputs.changed == 'true' && matrix.command != 'upstream'
        uses: peter-evans/create-pull-request@v7
        with:
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT }}
          branch: bot/${{ matrix.command }}
          delete-branch: true
          commit-message: "${{ steps.bot.outputs.title }}"
          title: "${{ steps.bot.outputs.title }}"
          body-path: ${{ runner.temp }}/summary.md
          labels: robostack-bot,${{ steps.bot.outputs.labels }}

      - name: Open the template pull request (upstream)
        if: steps.bot.outputs.changed == 'true' && matrix.command == 'upstream'
        uses: peter-evans/create-pull-request@v7
        with:
          path: .template-src
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT }}
          branch: bot/upstream-[= distro =]
          commit-message: "${{ steps.bot.outputs.title }}"
          title: "${{ steps.bot.outputs.title }}"
          body-path: ${{ runner.temp }}/summary.md

      - name: Reply to the comment
        if: always() && github.event_name == 'issue_comment'
        env:
          GH_TOKEN: ${{ github.token }}
          NUMBER: ${{ github.event.issue.number }}
        run: |
          {
            echo "**robostack-bot ${{ matrix.command }}**: ${{ steps.bot.outputs.title || 'failed' }}"
            echo
            [ -f "$RUNNER_TEMP/summary.md" ] && cat "$RUNNER_TEMP/summary.md"
            echo
            echo "[Workflow run]($GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID)"
          } > "$RUNNER_TEMP/comment.md"
          gh issue comment "$NUMBER" --repo "$GITHUB_REPOSITORY" --body-file "$RUNNER_TEMP/comment.md"
