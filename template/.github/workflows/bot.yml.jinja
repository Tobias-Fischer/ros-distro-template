# This file is generated from ros-distro-template (template/.github/workflows/bot.yml.jinja).
# If you change it here, upstream the change: comment `@robostack-bot upstream-to-template` on your PR.

# robostack-bot: routine maintenance for ros-[= distro =].
#
# - weekly: refresh the rosdistro snapshot (PR)
# - on demand (owners, members and collaborators only):
#     Actions > robostack-bot > Run workflow,
#     an issue from the "robostack-bot command" issue template, or
#     a comment `@robostack-bot <command>` on an issue/PR
#   commands: update-from-template | update-rosdistro-snapshot | find-stale-packages |
#             check-template-drift | upstream-to-template
#   (the shared conda-forge pinning is updated in the template repository)
# - on pull requests: warn when template-owned files are edited by hand
#
# The bot logic lives in [= template_url =] (robostack_bot/).
# PRs are opened with the robostack-bot GitHub App token (vars.ROBOSTACK_BOT_APP_ID +
# secrets.ROBOSTACK_BOT_PRIVATE_KEY), falling back to secrets.GHA_PAT, so that
# testpr.yml runs on them. Without either, GITHUB_TOKEN is used: that needs
# "Allow GitHub Actions to create and approve pull requests" in the repository
# settings, CI won't run on those PRs, and upstream-to-template can't push to the
# template repository.
name: robostack-bot

on:
  schedule:
    - cron: "17 3 * * 1"
  workflow_dispatch:
    inputs:
      command:
        description: Command to run
        type: choice
        options: [update-from-template, update-rosdistro-snapshot, find-stale-packages, check-template-drift, upstream-to-template]
      vcs_ref:
        description: Template version for update-from-template (default latest)
        required: false
  issue_comment:
    types: [created]
  issues:
    types: [opened]
  pull_request:

permissions:
  contents: read

env:
  TEMPLATE_URL: [= template_url =]
  BOT: uvx --from git+[= template_url =] robostack-bot

jobs:
  check-template-drift:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@v7
      - name: Check template-owned files
        id: bot
        run: $BOT --summary "$RUNNER_TEMP/summary.md" check-template-drift
      - name: Report
        if: steps.bot.outputs.ok == 'false'
        env:
          GH_TOKEN: ${{ github.token }}
          PR: ${{ github.event.pull_request.number }}
        run: |
          cat "$RUNNER_TEMP/summary.md" >> "$GITHUB_STEP_SUMMARY"
          echo "::warning::Template-owned files were edited; see the job summary."
          gh label create upstream-to-template --repo "$GITHUB_REPOSITORY" --color d93f0b \
            --description "Edits template-owned files; move them into the template" 2>/dev/null || true
          gh pr edit "$PR" --repo "$GITHUB_REPOSITORY" --add-label upstream-to-template || true

  plan:
    if: >-
      github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' ||
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@robostack-bot')) ||
      (github.event_name == 'issues' && contains(github.event.issue.labels.*.name, 'robostack-bot'))
    runs-on: ubuntu-latest
    outputs:
      commands: ${{ steps.plan.outputs.commands }}
    steps:
      - uses: astral-sh/setup-uv@v7
      - name: Decide what to run
        id: plan
        env:
          EVENT: ${{ github.event_name }}
          INPUT: ${{ inputs.command }}
          BODY: ${{ github.event.comment.body || github.event.issue.body }}
          ASSOCIATION: ${{ github.event.comment.author_association || github.event.issue.author_association }}
        run: |
          case "$EVENT" in
            schedule) commands='["update-rosdistro-snapshot"]' ;;
            workflow_dispatch) commands="[\"$INPUT\"]" ;;
            issue_comment|issues)
              command=$($BOT parse-command --body "$BODY" --association "$ASSOCIATION")
              if [ -n "$command" ]; then commands="[\"$command\"]"; else commands='[]'; fi ;;
          esac
          echo "commands=$commands" >> "$GITHUB_OUTPUT"

  run:
    needs: plan
    if: needs.plan.outputs.commands != '[]'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        command: ${{ fromJSON(needs.plan.outputs.commands) }}
    permissions:
      contents: write
      pull-requests: write
      issues: write
    steps:
      - name: Bot token
        id: app
        if: vars.ROBOSTACK_BOT_APP_ID != ''
        uses: actions/create-github-app-token@v2
        with:
          app-id: ${{ vars.ROBOSTACK_BOT_APP_ID }}
          private-key: ${{ secrets.ROBOSTACK_BOT_PRIVATE_KEY }}
          owner: ${{ github.repository_owner }}
          repositories: ${{ github.event.repository.name }},[= template_repo.split('/')[1] =]

      - uses: actions/checkout@v6
        with:
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT || github.token }}
          fetch-depth: 0
          # Commands that inspect a pull request's changes (a comment on a PR) run
          # on its head; everything else runs on the default branch.
          ref: >-
            ${{ github.event.issue.pull_request &&
                contains(fromJSON('["check-template-drift","upstream-to-template"]'), matrix.command) &&
                format('refs/pull/{0}/head', github.event.issue.number) || '' }}

      - uses: prefix-dev/setup-pixi@v0.10.2
        with:
          pixi-version: v0.75.0
          run-install: false
      - uses: astral-sh/setup-uv@v7

      - name: Check out the template (upstream-to-template)
        if: matrix.command == 'upstream-to-template'
        uses: actions/checkout@v6
        with:
          repository: [= template_repo =]
          path: .template-src
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT || github.token }}

      - name: robostack-bot ${{ matrix.command }}
        id: bot
        env:
          COMMAND: ${{ matrix.command }}
          VCS_REF: ${{ inputs.vcs_ref }}
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          git config --global user.name "robostack-bot"
          git config --global user.email "robostack-bot@users.noreply.github.com"
          args=()
          case "$COMMAND" in
            update-from-template) [ -n "$VCS_REF" ] && args+=(--vcs-ref "$VCS_REF") ;;
            upstream-to-template) args+=(--template-dir .template-src) ;;
          esac
          $BOT --summary "$RUNNER_TEMP/summary.md" "$COMMAND" "${args[@]}"
          cat "$RUNNER_TEMP/summary.md" >> "$GITHUB_STEP_SUMMARY"

      - name: Open or update the pull request
        if: steps.bot.outputs.changed == 'true' && matrix.command != 'upstream-to-template'
        uses: peter-evans/create-pull-request@v7
        with:
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT || github.token }}
          branch: bot/${{ matrix.command }}
          delete-branch: true
          commit-message: "${{ steps.bot.outputs.title }}"
          title: "${{ steps.bot.outputs.title }}"
          body-path: ${{ runner.temp }}/summary.md
          labels: robostack-bot,${{ steps.bot.outputs.labels }}

      - name: Open the template pull request (upstream-to-template)
        if: steps.bot.outputs.changed == 'true' && matrix.command == 'upstream-to-template'
        uses: peter-evans/create-pull-request@v7
        with:
          path: .template-src
          token: ${{ steps.app.outputs.token || secrets.GHA_PAT || github.token }}
          branch: bot/upstream-to-template-[= distro =]
          commit-message: "${{ steps.bot.outputs.title }}"
          title: "${{ steps.bot.outputs.title }}"
          body-path: ${{ runner.temp }}/summary.md

      - name: Reply on the issue / pull request
        if: always() && (github.event_name == 'issue_comment' || github.event_name == 'issues')
        env:
          GH_TOKEN: ${{ github.token }}
          NUMBER: ${{ github.event.issue.number }}
        run: |
          {
            echo "**robostack-bot ${{ matrix.command }}**: ${{ steps.bot.outputs.title || 'failed' }}"
            echo
            [ -f "$RUNNER_TEMP/summary.md" ] && cat "$RUNNER_TEMP/summary.md"
            echo
            echo "[Workflow run]($GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID)"
          } > "$RUNNER_TEMP/comment.md"
          gh issue comment "$NUMBER" --repo "$GITHUB_REPOSITORY" --body-file "$RUNNER_TEMP/comment.md"
          # Issues opened from the "robostack-bot command" template are done now.
          if [ "$GITHUB_EVENT_NAME" = issues ] && [ "${{ steps.bot.outcome }}" = success ]; then
            gh issue close "$NUMBER" --repo "$GITHUB_REPOSITORY"
          fi
